{
  "expo": {
    "name": "FamWell",
    "slug": "famwell-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "buildNumber": "1",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "FamWell connects to your local development server during development."
      }
    },
    "android": {
      "permissions": [
        "android.permission.INTERNET"
      ],
      "versionCode": 1,
      "package": "com.famwell"
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "googleWebClientId": "412498275721-g00rftt1jbvc3555cii3uss72g0qp5g3.apps.googleusercontent.com",
      "apiUrl": "https://famwell-v0-1.onrender.com",
      "apiUrls": [
        "https://famwell-v0-1.onrender.com",
        "http://10.15.54.74:8000"
      ],
      "eas": {
        "projectId": "9414b103-e658-42e8-8a2c-1d726301ca90"
      }
    },
    "scheme": "famwell-mobile",
    "owner": "ayush_karn.01",
    "plugins": [
      "expo-web-browser"
    ]
  }
}
